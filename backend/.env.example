# Copy this file to .env and fill in. .env is git-ignored: never commit keys.

# Which model host to use. Meta Model API:
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3
LLM_API_KEY=

# Fallback example (open weights). Copy the exact model ID from the provider's page.
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_MODEL=
# LLM_API_KEY=

# Private mode (Muse Glimmer on your own Modal endpoint), filled in later
# PRIVATE_BASE_URL=
# PRIVATE_MODEL=
# PRIVATE_API_KEY=
